{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "strict": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "*": ["../apps/web-admin/node_modules/*"]
    }
  },
  "include": [
    "**/*"
  ]
}
