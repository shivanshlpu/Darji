# Server Port
PORT=5000

# MongoDB Atlas Connection String (Replace with your Atlas credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/darji_erp

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Environment
NODE_ENV=production

# WhatsApp Engine Toggle
ENABLE_WHATSAPP=true
