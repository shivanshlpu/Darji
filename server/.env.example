# Environment Variables Template for Backend (Render / VPS)
# DO NOT commit actual secrets here. Copy to .env or paste into platform settings.

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/darji_erp
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=3650d
NODE_ENV=production

# Admin Owner Account Credentials (Set in platform Environment Variables)
ADMIN_PHONE=your_admin_phone_number
ADMIN_PASSWORD=your_admin_password
